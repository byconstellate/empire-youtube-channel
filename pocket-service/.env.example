# --- pocket-tts (existing) ---
TTS_TOKEN=replace-with-a-long-random-secret
TTS_DOMAIN=tts.constellate.online

# --- render-worker (new) ---
# Pick a new subdomain, pointed at this VM's IP the same way TTS_DOMAIN is.
RENDER_DOMAIN=render.constellate.online
# Optional: leave blank to leave the render worker open to anyone with the
# URL (matches how pocket-tts is currently configured), or set a long random
# secret here to require it in the X-Render-Token header on every request.
RENDER_SERVICE_TOKEN=
# Required for footage search to work at all.
GIPHY_API_KEY=
PEXELS_API_KEY=
