PEXELS_API_KEY=
# Google voice language code, for example en, en-au, en-uk, or th.
GOOGLE_TTS_LANGUAGE=en
# Optional: use a specific installed font file for captions.
FONT_FILE=
# Optional output overrides.
VIDEO_WIDTH=1920
VIDEO_HEIGHT=1080
VIDEO_FPS=30
# For portrait footage in the landscape canvas: top_to_bottom or bottom_to_top.
VIDEO_PAN_DIRECTION=top_to_bottom